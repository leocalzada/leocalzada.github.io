@INCOLLECTION{Figueroa2019-lq,
  title     = "Gobernanza del Manejo de los Recursos Forestales en México",
  author    = "Figueroa, Fernanda and Calzada, Leonardo",
  editor    = "Ávila Foucat, Véronique Sophie and Perevochtchikova, María",
  booktitle = "Sistemas socio-ecológicos: marcos analíticos y estudios de caso
               en Oaxaca, México",
  publisher = "Institute of Economic Research, National Autonomous University of
               Mexico",
  pages     = "205--226",
  abstract  = "Las interacciones entre la sociedad y la naturaleza son
               complejas, dinámicas y se ubican en diferentes escalas
               espacio-temporales, por lo que se consideran sistemas
               socio-ecológicos. Las políticas públicas son generalmente
               sectoriales sin tomar en cuenta la complejidad de los territorios
               y dichas interacciones, ocasionando soluciones fraccionadas y
               poco eficientes. Por ello, es crucial analizar las trayectorias
               de los sistemas socio-ecológicos desde un punto de vista
               sistémico y transdisciplinario. Por lo antes expuesto, el
               objetivo del libro es mostrar la diversidad de marcos analíticos,
               teóricos y conceptuales que pueden aplicarse para el análisis de
               los sistemas socio-ecológicos, así como la complejidad
               institucional y la influencia de las condiciones estructurales y
               estresores en los socio-ecosistemas destacando el estado de
